      "renewal": {
       "description": "If funding arrangements are extended, the Framework term will be extended accordingly.\nThe Framework is therefore expected to run for an an initial period of 2 years with the council retaining the option to extend for 2 further periods of 12 months each"
      },
      "hasOptions": false,
      "status": "active"
     },
