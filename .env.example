APP_NAME="Creatium Lab"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=bg
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uniproject
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Creatium Lab (публичен сайт) ---
# Разкоментирайте и попълнете реалните данни. Без тях се ползват стойностите от config/creatium.php.
# CREATIUM_EMAIL=info@creatiumlab.com
# CREATIUM_PHONES="+359 895 457 247, +359 877 200 546"
# CREATIUM_CITY=София
# CREATIUM_NOTIFY_EMAIL=info@creatiumlab.com
# CREATIUM_COMPANY="Име на фирмата/ЕТ"
# CREATIUM_EIK=123456789
# CREATIUM_ADDRESS="гр. София, ул. ..."

# Google Tag Manager. В production по подразбиране е GTM-5QRGW6DP; GTM_ID= (празно) го изключва.
# GA4, Clarity и пикселите се настройват в GTM и тръгват само след съгласие в банера за бисквитки.
# GTM_ID=GTM-XXXXXXX

# Google Search Console, метод „HTML tag“: само стойността от content="...". Не е нужно при потвърждение през DNS.
# GOOGLE_SITE_VERIFICATION=

# Отговори на отзиви в админа: с ключ черновите се пишат от Claude, без него от шаблон.
ANTHROPIC_API_KEY=

# По желание: проверка на имейлите от търсенето на бизнеси (reoon.com, 600 безплатни на месец).
REOON_API_KEY=

# По желание: търсене на бизнеси в Google Maps (serper.dev, 2 500 безплатни търсения). Без него се търси в OpenStreetMap.
SERPER_API_KEY=

# Оценката на Creatium Lab в Google (от профила в Google Business). Показва се на началната страница само когато има отзиви.
GOOGLE_REVIEWS_RATING=
GOOGLE_REVIEWS_COUNT=
GOOGLE_REVIEWS_URL=

# Чатът на сайта. Отговаря с AI при зададен ключ (ANTHROPIC_API_KEY или MISTRAL_API_KEY), иначе от честите въпроси.
# CHAT_PROVIDER: auto (Claude, ако има ключ, иначе Mistral), anthropic или mistral.
CHAT_ENABLED=true
CHAT_PROVIDER=auto
# Mistral (безплатен план от console.mistral.ai). Преди да сложите ключа, изключете използването на данните за обучение в акаунта.
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-medium-latest
CHAT_DAILY_LIMIT=300
# По желание: друг модел само за чата (по подразбиране ANTHROPIC_MODEL).
# ANTHROPIC_CHAT_MODEL=
